# Copy to backend/.env and fill in real values. Never commit the filled copy.
# Every var below is validated at startup in backend/src/config.ts or read in
# backend/src/lib — a missing one crashes the container immediately.

# OpenAI-compatible endpoint used for chat completions and embeddings.
AI_URL=https://api.openai.com/v1
AI_KEY=
AI_MODEL=
AI_EMBED_MODEL=

# Supabase project holding the movie vector store.
# Use the secret/service key — this is server-side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# TMDB read access token, used as a bearer token for poster lookups.
TMDB_API=

# Port Express binds to. Defaults to 3000 when unset.
PORT=3000
